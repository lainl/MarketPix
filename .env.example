PORT=3008
# Folder holding the web pages, relative to the Java folder (the Docker image sets it to /app/ui).
MARKETPIX_UI_DIR=../UserInterface
# Path to magick when ImageMagick is not on the PATH; leave empty to search for it.
MARKETPIX_IMAGEMAGICK=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_VISION_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_SIZE=2048x2048
# Bulk edit (Dropbox) image settings; leave empty to use the model and size above at high quality.
OPENAI_BULK_IMAGE_MODEL=gpt-image-1.5
OPENAI_BULK_IMAGE_SIZE=1024x1024
OPENAI_BULK_IMAGE_QUALITY=medium
R2_ACCOUNT_ID=
R2_BUCKET=marketpix-images
# Leave empty to use https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Time zone of the day and time inside each id, such as America/Halifax or -04:00; empty uses the server's.
MARKETPIX_ID_TIMEZONE=
MARKETPIX_BACKGROUND_ENABLED=true
MARKETPIX_USERNAME=
MARKETPIX_PASSWORD=
# Days a login stays valid without use, and the private file that keeps logins across restarts (token hashes
# only); leave the file empty to keep logins in memory.
MARKETPIX_SESSION_DAYS=30
MARKETPIX_SESSION_FILE=
DROPBOX_ACCOUNT_EMAIL=marketpixs@gmail.com
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# Only used while there is no refresh token; expires after about four hours.
DROPBOX_ACCESS_TOKEN=
MARKETPIX_BULK_COST_PER_PHOTO=0.25
MARKETPIX_BULK_COST_PER_ITEM=0.02
MARKETPIX_BULK_MAX_PHOTOS=500
# false saves bulk photos as is, without calling OpenAI.
MARKETPIX_BULK_AI_EDITING=true
# Folder that keeps each bulk job's progress, so a job resumes after a restart instead of starting over.
MARKETPIX_BULK_JOBS_DIR=
